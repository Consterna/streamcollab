{
  "name": "streamcollab",
  "version": "1.5.1",
  "description": "StreamCollab HUD + OBS Squad-Marker Monorepo",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=packages/client",
    "typecheck": "tsc -b && npm run typecheck --workspace=packages/client && tsc -p e2e",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "playwright test",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev": "npm run dev:server",
    "start": "npm run start --workspace=packages/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
