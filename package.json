{
  "name": "streamcollab",
  "version": "1.6.2",
  "description": "Collaborative squad markers for OBS Studio with SMPTE timecode NLE exports (DaVinci Resolve, Premiere Pro, YouTube chapters)",
  "license": "MIT",
  "homepage": "https://github.com/Consterna/streamcollab#readme",
  "bugs": {
    "url": "https://github.com/Consterna/streamcollab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Consterna/streamcollab.git"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=packages/client",
    "typecheck": "tsc -b && npm run typecheck --workspace=packages/client && tsc -p e2e",
    "clean": "tsc -b --clean",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "e2e": "playwright test",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mts,mjs,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mts,mjs,json}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev": "npm run dev:server",
    "start": "npm run start --workspace=packages/server",
    "backup": "npm run backup --workspace=packages/server --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
