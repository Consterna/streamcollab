{
  "name": "streamcollab",
  "version": "1.3.0",
  "description": "StreamCollab HUD + OBS Squad-Marker Monorepo",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=packages/client",
    "typecheck": "tsc -b && npm run typecheck --workspace=packages/client",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev": "npm run dev:server",
    "start": "npm run start --workspace=packages/server"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
