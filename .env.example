# ==============================================================================
# StreamCollab Environment Configuration Example
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Public domain for docker-compose / Caddy (automatic HTTPS), e.g. collab.example.com
DOMAIN=
# Optional: docker-compose image tag from ghcr.io/consterna/streamcollab (e.g. 1.6, latest)
# STREAMCOLLAB_TAG=

# Database Persistence
# Optional: path to SQLite database (defaults to ./streamcollab.sqlite; /data/... in Docker)
DATABASE_PATH=./streamcollab.sqlite

# Optional: compiled client to serve at "/" (defaults to packages/client/dist)
CLIENT_DIST=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Security
# Comma-separated origins allowed to call the REST API cross-origin.
# Leave empty when the client is served by this same server (recommended).
ALLOWED_ORIGIN=
# Optional: enables GET /api/rooms (list every room) for "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=
# Rooms one IP may create per minute
ROOM_CREATE_LIMIT_PER_MINUTE=10
# Simultaneous WebSocket connections from one IP (raise it when many streamers share one IP)
MAX_SOCKETS_PER_IP=64
# Set to true behind a reverse proxy (Caddy / Nginx) so rate limits see the real client IP.
# Left false behind a proxy, every client shares its IP and the per-IP limits (room creation,
# unknown room codes, 64 WebSocket connections) apply to all of them together.
TRUST_PROXY=false

# Note: the OBS WebSocket address / password are entered in each streamer's Dock
# (they never reach the server).
